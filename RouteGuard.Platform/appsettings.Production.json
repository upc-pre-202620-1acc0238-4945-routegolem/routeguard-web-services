{
  "TokenSettings": {
    "Secret": "%JWT_SECRET%",
    "ExpirationDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=%DATABASE_URL%;Port=%DATABASE_PORT%;Database=%DATABASE_SCHEMA%;Username=%DATABASE_USER%;Password=%DATABASE_PASSWORD%;SSL Mode=Require;Trust Server Certificate=true"
  },
  "RabbitMQ": {
    "Url": "%RABBITMQ_URL%"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
